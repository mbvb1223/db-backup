; Copy to .env. Comments start with ";" on their own line. Quote values with special characters, e.g. "~/.ssh/id_ed25519".

; Deploy: on your machine, read by vendor/bin/dep deploy
DEPLOY_HOST=
DEPLOY_USER=root
; DEPLOY_PORT=22
; DEPLOY_IDENTITY_FILE="~/.ssh/id_ed25519"

; Upload: on the server (shared/.env), read by config.php
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
