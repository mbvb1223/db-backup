# Copy to .env. Comments must be on their own line; quote values with special characters ("~/.ssh/...").

# Deploy: on your machine, read by `vendor/bin/dep deploy`
DEPLOY_HOST=11.22.33.123
DEPLOY_USER=root
DEPLOY_PORT=26266
DEPLOY_IDENTITY_FILE='~/.ssh/id_ed25519'

# Upload: on the server (shared/.env), read by config.php
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Slack: Incoming Webhook URL for run summaries and errors (optional)
SLACK_WEBHOOK_URL=
